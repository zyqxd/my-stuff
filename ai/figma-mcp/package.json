{
  "name": "pi-figma-mcp",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "pi-mcp-adapter": "2.23.0"
  },
  "description": "Figma MCP server + Figma's official skills, packaged for the pi coding agent.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./vendor/figma-mcp-server-guide/skills/figma-design-to-code",
      "./vendor/figma-mcp-server-guide/skills/figma-code-connect"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zyqxd/pi-figma-mcp.git"
  },
  "scripts": {
    "postinstall": "node ./scripts/fetch-skills.mjs"
  }
}
